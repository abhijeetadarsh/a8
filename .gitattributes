# These run on Linux (the Arch ISO / installed system) - always store and check
# out with LF endings, even when edited on Windows.
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# the dotfiles all target Linux (i3 rice) - force LF regardless of extension
dotfiles/** text=auto eol=lf
