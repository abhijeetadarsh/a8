{
  "_comment": [
    "A saved answer set from a real run, replayed with:",
    "    python archsetup.py --config answers.example.json",
    "Passwords are never stored here and are always re-asked.",
    "Only keys the installer actually asks are meaningful; anything else is ignored.",
    "This example targets an Intel+NVIDIA laptop dual-booting Windows on nvme0n1."
  ],
  "_detected": {
    "cpu": "intel",
    "gpus": [
      "nvidia",
      "intel"
    ],
    "laptop": true,
    "uefi": true,
    "virt": "none"
  },

  "mirrors_country": "India",
  "mirrors_rank": true,
  "parallel_downloads": "10",
  "multilib": true,
  "pacman_candy": true,

  "part_root": "/dev/nvme0n1p6",
  "root_fs": "btrfs",
  "format_root": true,
  "btrfs_subvolumes": false,
  "btrfs_compress": "none",
  "luks_enable": false,

  "part_esp": "/dev/nvme0n1p3",
  "esp_mountpoint": "/boot",
  "format_esp": false,

  "home_separate": false,
  "part_home": null,

  "swap_kind": "partition",
  "part_swap": "/dev/nvme0n1p5",
  "format_swap": true,
  "hibernate": false,

  "extra_mounts_enable": false,

  "hostname": "archlinux",
  "timezone": "Asia/Kolkata",
  "locale": "en_US.UTF-8",
  "extra_locales": "",
  "keymap": "us",
  "x11_layout": "us",

  "username": "a8",
  "user_fullname": "",
  "user_groups": "wheel",
  "sudo_nopasswd": true,
  "root_locked": true,

  "kernel": "linux",
  "kernel_fallback": true,
  "firmware": true,
  "microcode": "intel-ucode",

  "bootloader": "systemd-boot",
  "sdboot_timeout": "3",
  "quiet_boot": true,
  "extra_cmdline": "",
  "os_prober": false,

  "gpu_driver": "nvidia-proprietary"
}
