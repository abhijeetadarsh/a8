/*
 * rofi theme - layout and typography here, colours in colors.rasi.
 *
 * colors.rasi is generated from the wallpaper by theme_engine on every
 * theme_init.sh run, so it is deliberately not in the repo. If rofi complains
 * it cannot find the import, run ~/.config/i3/script/theme_init.sh once.
 */

@import "colors.rasi"

configuration {
	display-drun:   "";
	display-run:    "";
	display-window: "";
	drun-display-format: "{name}";
	modi: "drun,run,window";
	show-icons: true;
}

* {
	font: "CaskaydiaCove Nerd Font 11";

	background-color: transparent;
	text-color:       @fg;

	border:  0;
	margin:  0;
	padding: 0;
	spacing: 0;
}

window {
	width:            42%;
	background-color: @bg;
	border:           2px;
	border-color:     @accent;
	border-radius:    8px;
	padding:          0;
}

mainbox {
	children: [ inputbar, listview ];
	padding:  8px;
	spacing:  8px;
}

inputbar {
	children:         [ prompt, entry ];
	background-color: @bg-bar;
	border-radius:    6px;
	padding:          10px 12px;
	spacing:          10px;
}

prompt {
	text-color:     @accent;
	vertical-align: 0.5;
}

entry {
	placeholder:       "search";
	placeholder-color: @fg-alt;
	vertical-align:    0.5;
}

listview {
	columns:      1;
	lines:        9;
	scrollbar:    false;
	fixed-height: false;
	spacing:      2px;
}

element {
	padding:       8px 12px;
	spacing:       10px;
	border-radius: 6px;
}

element normal.normal    { text-color: @fg; }
element alternate.normal { text-color: @fg; }
element normal.urgent    { text-color: @urgent; }
element alternate.urgent { text-color: @urgent; }

element selected.normal {
	background-color: @accent;
	text-color:       @bg;
}

element selected.urgent {
	background-color: @urgent;
	text-color:       @bg;
}

element-icon {
	size:           24px;
	vertical-align: 0.5;
}

element-text {
	text-color:     inherit;
	vertical-align: 0.5;
}

message {
	background-color: @bg-bar;
	border-radius:    6px;
	padding:          10px;
}

textbox {
	text-color: @fg;
}
