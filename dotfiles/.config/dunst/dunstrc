# dunst - notification daemon.
#
# Colours are NOT here. dunst reads ~/.config/dunst/dunstrc.d/*.conf after this
# file, and theme_engine writes 99-theme.conf there on every wallpaper change,
# so the urgency_* colour blocks come from the current palette.
#
# What is here is geometry, fonts and behaviour, which do not change with the
# theme. polybar's updates.sh and anything calling notify-send lands here.

[global]
    monitor = 0
    follow = mouse

    width = (300, 420)
    height = (0, 300)
    origin = top-right
    offset = (14, 14)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 400
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    separator_height = 4
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    corner_radius = 8
    gap_size = 6

    separator_color = frame
    sort = yes

    # Matches the i3 title font and polybar.
    font = Fantasque Sans Mono 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left

    # 24, and it has to be, which is not obvious.
    #
    # With recursive lookup dunst asks the icon theme for exactly one size -
    # this one - and every directory in Papirus is `Type=Fixed`, meaning it
    # answers only for its own size. So this is not a floor with scaling above
    # it: it is the single shelf dunst is allowed to look on.
    #
    # Papirus ships its actions and status icons at 16, 22 and 24 only; 32
    # exists for apps and devices and almost nothing else. At 32 every
    # `audio-volume-*` lookup therefore returned nothing and the notification
    # came up with no icon at all, silently. 24 is the largest size the whole
    # set is drawn at, so it is the one where every name resolves.
    #
    # This does not touch images passed as a path - a screenshot thumbnail or
    # a wallpaper - which are only capped by max_icon_size below.
    min_icon_size = 24
    max_icon_size = 64

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
