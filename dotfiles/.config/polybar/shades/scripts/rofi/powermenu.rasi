/*
 * powermenu - deliberately the same visual language as the launcher in
 * ~/.config/rofi/theme.rasi: same border, same radius, same accent selection.
 * Two menus on one desktop looking like they came from different programs is
 * what this replaces.
 *
 * Sized for five fixed entries rather than a searchable list, so it is narrow,
 * has no search box, and puts the uptime where the launcher has its prompt.
 *
 * The old version used @ac, which the generated palette does not define - rofi
 * silently falls back on an unresolved colour - along with "transparency: real"
 * and hardcoded #FFFFFF, which is why it did not match anything.
 *
 * colors.rasi is the shim onto the generated palette.
 */

@import "colors.rasi"

configuration {
	show-icons:      false;
	disable-history: true;
}

* {
	font: "CaskaydiaCove Nerd Font 11";

	background-color: transparent;
	text-color:       @fg;

	border:  0;
	margin:  0;
	padding: 0;
	spacing: 0;
}

window {
	width:            320px;
	background-color: @bg;
	border:           2px;
	border-color:     @accent;
	border-radius:    8px;
	padding:          0;
	location:         center;
}

mainbox {
	children: [ inputbar, listview ];
	padding:  8px;
	spacing:  8px;
}

/* The launcher puts a search box here. There is nothing to search in a list of
 * five, so the same strip carries the uptime instead. */
inputbar {
	children:         [ prompt ];
	background-color: @bg-bar;
	border-radius:    6px;
	padding:          10px 12px;
}

prompt {
	text-color:     @fg-alt;
	vertical-align: 0.5;
}

listview {
	columns:      1;
	lines:        5;
	scrollbar:    false;
	fixed-height: true;
	spacing:      2px;
}

element {
	padding:       9px 12px;
	spacing:       10px;
	border-radius: 6px;
}

element normal.normal    { text-color: @fg; }
element alternate.normal { text-color: @fg; }

element selected.normal {
	background-color: @accent;
	text-color:       @bg;
}

element-text {
	text-color:     inherit;
	vertical-align: 0.5;
}
